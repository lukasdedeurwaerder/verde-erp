# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en gaat dus NOOIT mee naar GitHub.
# Op Vercel vul je dezelfde waarden in bij Settings -> Environment Variables.

# Publiek: mag in de browser terechtkomen. Beschermd door Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# GEHEIM: omzeilt alle beveiliging. Alleen server-side (accounts aanmaken).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Alleen lokaal nodig, om migraties uit te voeren (npm.cmd run migreer).
# Supabase-dashboard -> Connect -> Session pooler -> de URI, met je databankwachtwoord.
DATABASE_URL=postgresql://postgres.xxxx:WACHTWOORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
